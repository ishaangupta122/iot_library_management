# Copy to .env.local and fill in from Firebase console
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBpIxKwyqfCLBxN94INIQ-QHGiCkz9UzMA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smartlib-tiet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smartlib-tiet
NEXT_PUBLIC_FIREBASE_APP_ID=1:789580851013:web:2ff8a01c685ac97194002c

# The only email(s) allowed into the admin dashboard, comma separated.
NEXT_PUBLIC_ADMIN_EMAILS=admin.smartlib@gmail.com

# --- Live data (Firestore) ---
# Set to "firestore" to use the real database; leave empty to keep the built-in demo data.
NEXT_PUBLIC_DATA_SOURCE=

# Server only (never prefix with NEXT_PUBLIC_). From Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Secret the ESP32 sends so only your boards can post readings. Make it long and random, e.g. `openssl rand -hex 24`.
SENSOR_API_KEY=
